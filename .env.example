# ============================================================
#  J.A.R.V.I.S. · configuración
#  Copia este archivo como .env (o usa Ajustes ⚙ en la interfaz).
#  TODO es gratis. Puedes poner varias llaves del mismo proveedor
#  separadas por coma: JARVIS rota entre todas.
# ============================================================

# --- Tú ---
USUARIO_NOMBRE=
# Cómo quieres que te llame (ej: señor, jefe). Vacío = por tu nombre.
USUARIO_TRATAMIENTO=
# Vacío = se detecta por IP
CIUDAD=
PAIS=CO
JARVIS_NOMBRE=JARVIS

# --- Voz (edge-tts, gratis). Otras: es-MX-JorgeNeural, es-ES-AlvaroNeural, es-CO-SalomeNeural
# Las «Multilingual» (en-US-AndrewMultilingualNeural, en-US-BrianMultilingualNeural…) son las más naturales y hablan español
VOZ=es-CO-GonzaloNeural
# Tono: negativo = más grave (ej: -6Hz para un estilo JARVIS)
VOZ_TONO=+0Hz

# --- Rotación: equilibrio (reparte cuotas) | calidad | velocidad
ESTRATEGIA=equilibrio

# ============================================================
#  LLAVES DE IA GRATIS (de mejor a peor capa gratuita)
# ============================================================
# https://aistudio.google.com/apikey  · cuota por modelo, con visión
GEMINI_API_KEY=
# https://console.groq.com/keys  · rapidísimo, + Whisper para voz
GROQ_API_KEY=
# https://cloud.cerebras.ai  · muy rápido
CEREBRAS_API_KEY=
# https://console.mistral.ai/api-keys  · plan "Experiment" gratis
MISTRAL_API_KEY=
# https://github.com/settings/personal-access-tokens/new  · permiso "Models: read"  (GPT-4.1 gratis)
GITHUB_TOKEN=
# https://openrouter.ai/settings/keys  · todos los modelos ':free' se descubren solos
OPENROUTER_API_KEY=
# https://build.nvidia.com  · decenas de modelos abiertos
NVIDIA_API_KEY=
# https://cloud.sambanova.ai/apis
SAMBANOVA_API_KEY=
# https://dashboard.cohere.com/api-keys  · llave de prueba
COHERE_API_KEY=
# https://dash.cloudflare.com/profile/api-tokens  · plantilla "Workers AI"
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# https://huggingface.co/settings/tokens
HF_TOKEN=
# Ollama local o en tu CasaOS (modelos 100% offline)
OLLAMA_URL=http://localhost:11434/v1
OLLAMA_MODELO=
# auto (nube primero, local si escasean las cuotas) | siempre (local primero) | fondo | no
IA_LOCAL_MODO=auto

# ============================================================
#  Teléfono (Telegram, gratis): habla con JARVIS desde cualquier lugar
#  1) Crea un bot con @BotFather y pega el token
#  2) Escríbele al bot: te responde con tu ID -> ponlo en TELEGRAM_USUARIOS
# ============================================================
TELEGRAM_TOKEN=
TELEGRAM_USUARIOS=

# ============================================================
#  Notion (gratis): https://www.notion.so/profile/integrations -> nueva integración interna
#  Luego en cada página/base: «…» -> Conexiones -> añade la integración
# ============================================================
NOTION_TOKEN=

# ============================================================
#  Servidor casero CasaOS
# ============================================================
SERVIDOR_HOST=
SERVIDOR_USUARIO=
SERVIDOR_PUERTO_SSH=22
SERVIDOR_PUERTO_WEB=80
# Para encenderlo a distancia con Wake-on-LAN
SERVIDOR_MAC=

# ============================================================
#  Red
# ============================================================
JARVIS_HOST=127.0.0.1
JARVIS_PUERTO=8765
# Obligatoria si expones JARVIS en la red (Docker/CasaOS): se pide al entrar desde otra máquina
JARVIS_CLAVE=

# ============================================================
#  PC + celular con un solo cerebro (ver README)
# ============================================================
# En el PC: dirección del cerebro (servidor) y su clave. Vacío = este equipo piensa solo.
JARVIS_HUB=
JARVIS_HUB_CLAVE=
NODO_NOMBRE=
# Dirección HTTPS del cerebro para el celular (tailscale serve), usada en el QR
JARVIS_CELULAR_URL=
